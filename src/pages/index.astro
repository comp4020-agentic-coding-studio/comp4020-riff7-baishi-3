---
import Timetable from "../components/Timetable.astro";
import Base from "../layouts/Base.astro";
import { listRoster, listWeeks } from "../lib/db";

const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri"];
const DAY_NAMES: Record<string, string> = {
  Mon: "Monday",
  Tue: "Tuesday",
  Wed: "Wednesday",
  Thu: "Thursday",
  Fri: "Friday",
};

// Groups in weekday order, then by start time -- the db sorts day names
// alphabetically, which would put Friday first.
const roster = listRoster().sort(
  (a, b) => DAYS.indexOf(a.day) - DAYS.indexOf(b.day) || a.startTime.localeCompare(b.startTime),
);
const weeks = listWeeks();
const error = Astro.url.searchParams.get("error");

// Which teaching week is "now", in Canberra: the last week whose Monday has
// passed. Before week 1 that's week 1; in the mid-semester break it's the
// week before the break, flagged so the hero can say so.
const today = new Date().toLocaleDateString("en-CA", { timeZone: "Australia/Sydney" });
const addDays = (iso: string, n: number) => {
  const d = new Date(`${iso}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
};
const started = weeks.filter((w) => w.monday <= today);
const current = started.at(-1) ?? weeks[0];
const inBreak = current !== undefined && today > addDays(current.monday, 6) && current !== weeks.at(-1);
const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-AU", { day: "numeric", month: "short", timeZone: "UTC" });

const thisWeek = current
  ? roster.map((group) => ({ group, session: group.sessions.find((s) => s.week === current.week)! }))
  : [];
const movedCount = thisWeek.filter(({ session }) => session.exceptionId !== null).length;

// The timetable's week: ?week=N when it names a real teaching week, else
// this one.
const requested = Number(Astro.url.searchParams.get("week"));
const selectedWeek = weeks.some((w) => w.week === requested)
  ? requested
  : ((inBreak ? current.week + 1 : current?.week) ?? 1);
---

<Base
  title="Crit roster"
  description="This course's crit-group roster: standing weekly slots and per-week reschedule exceptions, persisted in SQLite and live-synced across tabs."
  current="roster"
>
  <main>
    <section class="hero" aria-labelledby="page-title">
      {
        current && (
          <p class="week-marker">
            <small>{inBreak ? "Mid-semester break · next up" : "Teaching week"}</small>
            {String(inBreak ? current.week + 1 : current.week).padStart(2, "0")}
          </p>
        )
      }
      <div>
        {
          current && (
            <p class="eyebrow">
              {fmt(current.monday)} – {fmt(addDays(current.monday, 4))} ·{" "}
              {movedCount === 0 ? "every crit at its usual slot" : `${movedCount} of ${thisWeek.length} crits moved`}
            </p>
          )
        }
        <h1 id="page-title">Where every crit meets, week by week</h1>
        <p class="hero-lede">
          Each group's usual slot, plus the weeks it moves. A reschedule here is
          saved for everyone, and any other open tab picks it up on its own.
        </p>
      </div>
    </section>

    {error && <p class="error" role="alert">{error}</p>}

    <Timetable roster={roster} weeks={weeks} selected={selectedWeek} current={inBreak ? undefined : current?.week} />
    <p id="stale-notice" class="notice" role="status" hidden>
      The roster changed in another tab. Your draft below is untouched —
      reload when you're ready to see the update.
    </p>

    <div class="section-head">
      <h2 id="groups-title">Crit groups</h2>
      <p>{roster.length} groups · {weeks.length} teaching weeks</p>
    </div>

    <div class="placards">
      {
        roster.map((group, i) => {
          const exceptionSessions = group.sessions.filter((s) => s.exceptionId !== null);
          return (
            <section class={`placard g${i}`} aria-labelledby={`group-${group.agent}`} style={`--i: ${i}`}>
              <div class="placard-head">
                <h3 id={`group-${group.agent}`}><a href={`/crit/${group.agent}`}>{group.name}</a></h3>
                <span class="placard-day">{DAY_NAMES[group.day] ?? group.day}s</span>
              </div>
              <div class="placard-body">
                <dl class="slot">
                  <dt>Usual</dt>
                  <dd class="time">
                    every {group.day} {group.startTime}–{group.endTime}
                  </dd>
                  <dt>Tutor</dt>
                  <dd>{group.tutorName}</dd>
                  <dt>Room</dt>
                  <dd>{group.room}</dd>
                </dl>
                {exceptionSessions.length === 0 ? (
                  <p class="steady">No moves this semester. Meets at its usual slot every teaching week.</p>
                ) : (
                  <ul class="moves">
                    {exceptionSessions.map((session) => (
                      <li class="move">
                        <span class="move-when">
                          Week {session.week} · {session.date}
                        </span>
                        <span class="move-where">
                          {session.day} {session.startTime}–{session.endTime} in {session.room}
                        </span>
                        <span class="move-why">{session.reason}</span>
                        <form method="post" action={`/api/exceptions/${session.exceptionId}/cancel`}>
                          <button class="btn-quiet" type="submit">
                            Undo move
                          </button>
                        </form>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </section>
          );
        })
      }
    </div>

    <div class="section-head">
      <h2 id="reschedule-title">Move a session</h2>
      <p>For one teaching week only. The usual slot stays as it is.</p>
    </div>

    <form class="panel" method="post" action="/api/exceptions" aria-labelledby="reschedule-title" id="move-form">
      <fieldset class="pick">
        <legend>Crit group</legend>
        <div class="group-chips">
          {roster.map((group, i) => {
            const [sh, sm] = group.startTime.split(":").map(Number);
            const [eh, em] = group.endTime.split(":").map(Number);
            return (
              <label class={`chip g${i}`}>
                <input
                  type="radio"
                  name="critGroupId"
                  value={group.id}
                  required
                  data-duration={eh * 60 + em - (sh * 60 + sm)}
                  data-room={group.room}
                />
                <span class="chip-name">{group.name}</span>
                <span class="chip-meta">
                  {group.day} {group.startTime}–{group.endTime}
                </span>
                <span class="chip-meta">{group.tutorName}</span>
              </label>
            );
          })}
        </div>
      </fieldset>

      <fieldset class="pick">
        <legend>Teaching week</legend>
        <div class="week-pills">
          {weeks.map((w, i) => (
            <>
              {i > 0 && addDays(weeks[i - 1].monday, 7) !== w.monday && (
                <span class="week-break" aria-hidden="true">break</span>
              )}
              <label class="pill">
                <input type="radio" name="week" value={w.week} required checked={w.week === selectedWeek} />
                <span>
                  <span class="visually-hidden">Week </span>
                  {String(w.week).padStart(2, "0")}
                </span>
              </label>
            </>
          ))}
        </div>
      </fieldset>

      <fieldset class="pick">
        <legend>New day</legend>
        <div class="day-pills">
          {DAYS.map((day) => (
            <label class="pill pill-day">
              <input type="radio" name="day" value={day} required />
              <span>{DAY_NAMES[day]}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="pick">
        <legend>Start time</legend>
        <div class="time-track" aria-hidden="true" data-from="08:00" data-to="19:00">
          <div class="time-track-range" hidden></div>
          {Array.from({ length: 11 }, (_, i) => (
            <span class="time-track-tick" style={`--at: ${i / 11}`}>{String(8 + i).padStart(2, "0")}</span>
          ))}
        </div>
        <p class="pick-hint" aria-hidden="true">Click or drag along the bar to set the start. Every crit runs 90 minutes.</p>
        <div class="time-fields">
          <div class="field">
            <label for="startTime">Start</label>
            <input id="startTime" name="startTime" type="time" step="900" required />
          </div>
          <div class="field">
            <span class="field-label" id="endTime-label">Ends (90 min)</span>
            <output class="end-display" id="endTime-display" for="startTime" aria-labelledby="endTime-label">--:--</output>
          </div>
        </div>
      </fieldset>

      <div class="panel-row">
        <div class="field">
          <label for="room">Room</label>
          <input id="room" name="room" type="text" placeholder="Usual room if blank" />
        </div>
        <div class="field">
          <label for="reason">Reason</label>
          <input id="reason" name="reason" type="text" required placeholder="e.g. Public holiday on the usual day" />
        </div>
      </div>

      <div class="panel-actions">
        <output class="move-summary" id="move-summary" for="startTime endTime"></output>
        <button class="btn" type="submit">Move session</button>
      </div>
    </form>

    <dialog class="move-dialog" id="move-dialog" aria-labelledby="move-dialog-title">
      <form method="post" action="/api/exceptions" id="dialog-form">
        <p class="eyebrow">Move for one week</p>
        <h2 id="move-dialog-title">Move session</h2>
        <p class="move-dialog-summary" id="move-dialog-summary"></p>
        <input type="hidden" name="critGroupId" />
        <input type="hidden" name="week" />
        <input type="hidden" name="day" />
        <input type="hidden" name="startTime" />
        <input type="hidden" name="endTime" />
        <div class="field">
          <label for="dialog-reason">Reason</label>
          <input id="dialog-reason" name="reason" type="text" required placeholder="e.g. Tutor away, swapped with Thursday" />
        </div>
        <div class="field">
          <label for="dialog-room">Room</label>
          <input id="dialog-room" name="room" type="text" placeholder="Usual room if blank" />
        </div>
        <div class="dialog-actions">
          <button class="btn-quiet" type="button" value="cancel" id="dialog-cancel">Keep it where it is</button>
          <button class="btn" type="submit">Move session</button>
        </div>
      </form>
    </dialog>
  </main>
  <script>
      import { createDirtyTracker, createReconnectGate } from "../lib/live-reload";
      import { initPlanner } from "../lib/planner";

      // The live half of the roster: reload on any change reported over the
      // SSE stream, so a tutor watching this page sees a reschedule made in
      // another tab without acting themselves. The form itself needs none of
      // this — its POST + redirect re-renders the submitting tab from
      // SQLite; this stream is how every other tab finds out.
      //
      // But a bare reload is only safe when there's nothing to lose: if this
      // tutor is mid-way through filling in their own reschedule, the same
      // reload that shows someone else's change would silently wipe their
      // draft too. Track that with the reschedule form's own `input` event
      // and skip the reload — showing a notice instead — whenever it fires.
      //
      // Dirty isn't one-way, though: typing a draft and then clearing it
      // back out leaves nothing to lose either, so every input event
      // re-compares the form's current values against its snapshot at page
      // load and marks clean again when they match — otherwise a tutor who
      // touched the form and backed out would have this tab's live sync
      // stay broken for the rest of its life over a draft that no longer
      // exists. Going clean also has to resolve any reload that was already
      // deferred while dirty — otherwise the stale notice just sits there
      // until some unrelated further change happens to arrive.
      const dirty = createDirtyTracker();
      const rescheduleForm = document.querySelector<HTMLFormElement>('form[action="/api/exceptions"]');
      const serialize = (form: HTMLFormElement) => new URLSearchParams(new FormData(form) as unknown as string[][]).toString();
      const pristineSnapshot = rescheduleForm ? serialize(rescheduleForm) : null;
      rescheduleForm?.addEventListener("input", () => {
        if (serialize(rescheduleForm) === pristineSnapshot) {
          dirty.markClean();
          if (dirty.claimPendingReload()) location.reload();
        } else {
          dirty.markDirty();
        }
      });

      // The planner's gestures (timetable clicks, the time bar) write into
      // the form without firing `input`, so re-run the same comparison by
      // hand; an open drop dialog is a draft too, whatever the form says.
      const recheckDraft = () => rescheduleForm?.dispatchEvent(new Event("input"));
      initPlanner({
        onDraft: recheckDraft,
        onDialog: (open) => {
          if (open) dirty.markDirty();
          else recheckDraft();
        },
      });

      const staleNotice = document.getElementById("stale-notice");
      const reloadUnlessDirty = () => {
        if (dirty.isDirty()) {
          dirty.notePendingReload();
          staleNotice?.removeAttribute("hidden");
        } else {
          location.reload();
        }
      };

      const source = new EventSource("/api/events");
      source.addEventListener("message", reloadUnlessDirty);

      // A dropped connection (a network blip, or on Fly.io the machine
      // auto-stopping while idle) reconnects on its own — that's the
      // browser's EventSource doing what the spec says. But any "changed"
      // ping broadcast while disconnected is gone: the in-memory bus keeps
      // no backlog. Reload on every reconnect too (see live-reload.ts), so
      // a tab that missed a change while disconnected still catches up
      // instead of sitting stale until the next one — subject to the same
      // dirty check, for the same reason.
      const shouldReloadOnOpen = createReconnectGate();
      source.addEventListener("open", () => {
        if (shouldReloadOnOpen()) reloadUnlessDirty();
      });
    </script>
</Base>
